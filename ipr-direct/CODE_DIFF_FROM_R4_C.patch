+                "ok"
+            )
+        ),
+        "positive": positive,
+        "minor_negative": bool(
+            analysis.get(
+                "minor_negative"
+            )
+        ),
+        "serious_negative": (
+            serious_negative
+        ),
+        "major_catalyst": bool(
+            analysis.get(
+                "major_catalyst"
+            )
+        ),
+        "bonus": bonus,
+        "headline": headline,
+        "category": str(
+            analysis.get("category")
+            or "neutral"
+        ),
+        "score": safe_float(
+            analysis.get("score")
+        ),
+        "cached": True,
+        "stale": stale,
+        "producer": str(
+            cached_item.get("producer")
+            or "elite_catalyst_radar"
+        )
+    }
