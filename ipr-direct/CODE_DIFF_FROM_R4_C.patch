+        ).strip(),
+        "source": str(
+            article.get("source") or ""
+        ).strip(),
+        "url": str(
+            article.get("url") or ""
+        ).strip(),
+        "category": str(
+            article.get("category") or ""
+        ).strip(),
+        "related": str(
+            article.get("related") or ""
+        ).strip(),
