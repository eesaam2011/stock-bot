+            "score": safe_float(
+                article_analysis.get(
+                    "score"
+                )
+            ),
+            "category": str(
+                article_analysis.get(
+                    "category"
+                )
+                or "neutral"
+            ),
+            "positive": bool(
+                article_analysis.get(
+                    "positive"
+                )
+            ),
+            "minor_negative": bool(
+                article_analysis.get(
+                    "minor_negative"
+                )
+            ),
+            "serious_negative": bool(
+                article_analysis.get(
+                    "serious_negative"
+                )
