+
+        if not normalized:
+            continue
+
+        published_ts = safe_float(
+            normalized.get("datetime")
+        )
+
+        if published_ts < cutoff_ts:
+            continue
+
+        if published_ts > now_ts + 300:
+            continue
+
+        article_id = normalized.get("id")
+
+        duplicate_key = (
+            str(article_id)
+            if article_id is not None
+            else (
+                f"{normalized.get('datetime')}:"
