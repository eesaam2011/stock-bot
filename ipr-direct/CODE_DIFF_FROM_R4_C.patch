+def filter_recent_news_articles(articles):
+    if not isinstance(articles, list):
+        return []
+
+    now_ts = time.time()
+
+    cutoff_ts = (
+        now_ts
+        - (NEWS_LOOKBACK_HOURS * 60 * 60)
+    )
+
+    normalized_articles = []
+
+    seen_articles = set()
+
+    for article in articles:
+        normalized = normalize_news_article(
+            article
