+        return int(float(value))
+
+    except Exception:
+        return default
+
+def normalize_news_article(article):
+    if not isinstance(article, dict):
+        return None
+
+    published_ts = safe_int(
+        article.get("datetime"),
+        0
+    )
+
+    if published_ts <= 0:
+        return None
+
+    article_analysis = article.get(
+        "analysis",
+        {}
+    )
+
+    if not isinstance(
+        article_analysis,
+        dict
