+        self.observation_errors=0
+
+    def _observe(self,fn):
+        try:
+            with self.lock:return fn()
+        except Exception:
+            # Diagnostics cannot replace a scan outcome or original exception.
+            self.observation_errors+=1
+
+    def begin(self,start,at):
+        def record():
